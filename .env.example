# PostgreSQL connection. `npm run db:up` starts a local one on port 5433.
DATABASE_URL="postgres://unicore:unicore_dev@127.0.0.1:5433/unicore"

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: where uploaded files are stored (default: ./data/uploads).
# UPLOAD_DIR="/var/lib/unicore/uploads"
